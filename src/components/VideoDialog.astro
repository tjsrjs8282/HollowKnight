<dialog class="video" id="video-dialog" aria-labelledby="video-dialog-title" data-video-dialog data-lenis-prevent>
  <div class="video__frame">
    <div class="video__player" data-video-player></div>
    <div class="video__bar">
      <h2 class="video__title" id="video-dialog-title" data-video-heading>Trailer</h2>
      <!-- autofocus keeps focus out of the cross-origin iframe, so Esc still closes. -->
      <button class="hk-btn video__close" type="button" autofocus data-video-close>Close</button>
    </div>
  </div>
</dialog>

<style>
  .video {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    color: inherit;
    background: rgb(3 4 9 / 0.92);
  }
  .video::backdrop {
    background: transparent;
  }
  .video[open] {
    display: grid;
    place-items: center;
    animation: fade 0.45s var(--ease-out);
  }
  .video.is-closing {
    animation: fade-out 0.3s var(--ease-in-out) forwards;
  }
  @keyframes fade {
    from { opacity: 0; }
  }
  @keyframes fade-out {
    to { opacity: 0; }
  }
  .video__frame {
    width: min(1180px, 100% - 32px, (100svh - 140px) * 16 / 9);
  }
  .video[open] .video__frame {
    animation: pop 0.6s var(--ease-out);
  }
  @keyframes pop {
    from { opacity: 0; transform: scale(0.96) translateY(14px); }
  }
  .video__player {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
    box-shadow: 0 40px 120px -20px rgb(0 0 0 / 0.9), 0 0 0 1px var(--line);
  }
  .video__player :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 4px;
    border-bottom: 1px solid var(--line);
  }
  .video__title {
    font-family: var(--font-display-stack);
    font-size: clamp(0.85rem, 0.8rem + 0.3vw, 1rem);
    font-weight: 400;
    letter-spacing: 0.14em;
    color: var(--pale-2);
  }
  .video__close {
    text-transform: uppercase;
    letter-spacing: 0.3em;
  }
</style>
