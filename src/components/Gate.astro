---
import { Image } from "astro:assets";
import SoulVessel from "./SoulVessel.astro";
import menuTop from "../assets/ornament/menu-top.png";
import menuBottom from "../assets/ornament/menu-bottom.png";
---

<div class="gate" role="dialog" aria-modal="true" aria-labelledby="gate-title" data-gate>
  <div class="gate__inner">
    <SoulVessel id="gate" class="gate__vessel" />
    <p class="gate__status eyebrow" data-gate-status>
      <span data-gate-percent>0</span>%
    </p>

    <div class="gate__menu" data-gate-menu>
      <Image src={menuTop} alt="" class="gate__orn" width={320} densities={[1, 2]} loading="eager" fetchpriority="high" />
      <h1 id="gate-title" class="gate__title">신성둥지로 들어서겠습니까?</h1>
      <div class="gate__choices">
        <button class="hk-btn" type="button" data-gate-enter="sound">소리와 함께 입장</button>
        <button class="hk-btn" type="button" data-gate-enter="silent">조용히 입장</button>
      </div>
      <p class="gate__hint">이어폰을 끼면 더 깊이 들립니다</p>
      <Image src={menuBottom} alt="" class="gate__orn gate__orn--bottom" width={260} densities={[1, 2]} loading="eager" />
    </div>
  </div>
</div>

<style>
  .gate {
    position: fixed;
    inset: 0;
    z-index: 120;
    display: grid;
    place-items: center;
    background:
      radial-gradient(60% 50% at 50% 46%, rgb(40 54 92 / 0.35), transparent 70%),
      var(--ink-0);
  }
  .gate__inner {
    display: grid;
    justify-items: center;
    gap: 18px;
    padding: 24px;
    text-align: center;
  }
  .gate__inner :global(.gate__vessel) {
    width: clamp(84px, 11vw, 112px);
    filter: drop-shadow(0 0 30px rgb(168 212 255 / 0.25));
  }
  .gate__status {
    min-height: 1.5em;
    color: var(--pale-3);
    letter-spacing: 0.5em;
    font-variant-numeric: tabular-nums;
  }
  .gate__menu {
    display: grid;
    justify-items: center;
    gap: 14px;
    margin-top: 8px;
    animation: gate-rise 1.1s var(--ease-out) 0.15s both;
  }
  @keyframes gate-rise {
    from {
      opacity: 0.01;
      transform: translateY(12px);
    }
  }
  .gate__orn {
    width: min(320px, 70vw);
    height: auto;
    opacity: 0.85;
  }
  .gate__orn--bottom {
    width: min(240px, 54vw);
  }
  .gate__title {
    font-family: var(--font-serif-stack);
    font-size: clamp(1.05rem, 0.98rem + 0.4vw, 1.3rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--pale);
  }
  .gate__choices {
    display: grid;
    gap: 2px;
  }
  .gate__hint {
    font-size: var(--fs-small);
    color: var(--pale-4);
  }

</style>
