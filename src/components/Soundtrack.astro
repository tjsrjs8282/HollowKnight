---
import { Image, getImage } from "astro:assets";
import SectionHeading from "./SectionHeading.astro";
import { TRACKS } from "../data/content";

// Covers swap client-side, so their optimized URLs travel as data.
const covers = await Promise.all(TRACKS.map((t) => getImage({ src: t.cover, width: 400, format: "webp" })));
const playlist = TRACKS.map((t, i) => ({ id: t.id, title: t.title, album: t.album, src: t.src, cover: covers[i].src, accent: t.accent }));
---

<section id="soundtrack" class="ost section" data-section="soundtrack" aria-labelledby="ost-title">
  <div class="ost__ambient" aria-hidden="true"></div>
  <div class="container ost__grid">
    <div class="ost__deck" data-reveal>
      <div class="ost__turntable" data-turntable>
        <canvas class="ost__viz" data-ost-viz aria-hidden="true"></canvas>
        <div class="ost__record" data-record>
          <div class="ost__grooves" aria-hidden="true"></div>
          <div class="ost__label">
            <Image src={TRACKS[0].cover} alt="" width={400} loading="lazy" data-ost-cover />
          </div>
        </div>
        <div class="ost__arm" aria-hidden="true"><i></i></div>
      </div>
    </div>

    <div class="ost__panel">
      <SectionHeading
        eyebrow="Soundtrack"
        title="크리스토퍼 라킨의 선율"
        id="ost-title"
        align="start"
        lead="현악과 피아노로 그려낸 신성둥지의 쓸쓸함. 곡을 고르면 레코드가 돌기 시작합니다."
      />

      <ol class="ost__list" role="list" data-reveal>
        {
          TRACKS.map((t, i) => (
            <li>
              <button class="ost__track" type="button" aria-pressed="false" style={`--accent:${t.accent}`} data-track={i}>
                <span class="ost__no">{String(i + 1).padStart(2, "0")}</span>
                <span class="ost__meta">
                  <span class="ost__title">{t.title}</span>
                  <span class="ost__album">{t.album}</span>
                </span>
                <span class="ost__dur">{t.duration}</span>
              </button>
            </li>
          ))
        }
      </ol>

      <div class="ost__controls" data-reveal>
        <button class="ost__btn" type="button" data-ost-prev aria-label="이전 곡">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5h2v14H6zM20 5v14L9 12z" fill="currentColor"></path></svg>
        </button>
        <button class="ost__btn ost__btn--main" type="button" data-ost-toggle aria-label="재생">
          <svg class="ost__icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4v16l13-8z" fill="currentColor"></path></svg>
          <svg class="ost__icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4h4v16H6zM14 4h4v16h-4z" fill="currentColor"></path></svg>
        </button>
        <button class="ost__btn" type="button" data-ost-next aria-label="다음 곡">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 5h2v14h-2zM4 5v14l11-7z" fill="currentColor"></path></svg>
        </button>
        <div class="ost__progress">
          <span class="ost__time" data-ost-time>0:00</span>
          <input class="ost__seek" type="range" min="0" max="1000" value="0" step="1" aria-label="재생 위치" data-ost-seek />
          <span class="ost__time" data-ost-duration>{TRACKS[0].duration}</span>
        </div>
      </div>
      <p class="ost__credit">음원 © Christopher Larkin · Team Cherry. 팬 페이지 감상용으로만 재생됩니다.</p>
    </div>
  </div>
  <audio preload="none" data-ost-audio></audio>
  <script type="application/json" data-ost-playlist set:html={JSON.stringify(playlist)} />
</section>

<style>
  .ost {
    overflow: hidden;
  }
  .ost__ambient {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(40% 50% at 25% 50%, color-mix(in srgb, var(--ost-accent, #a8d4ff) 14%, transparent), transparent 70%),
      radial-gradient(30% 40% at 80% 30%, rgb(60 80 140 / 0.12), transparent 70%);
    transition: background 1.2s;
  }
  .ost__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(32px, 6vw, 96px);
  }

  .ost__deck {
    display: grid;
    place-items: center;
  }
  .ost__turntable {
    position: relative;
    width: min(520px, 86vw);
    aspect-ratio: 1;
  }
  .ost__viz {
    position: absolute;
    inset: -14%;
    width: 128%;
    height: 128%;
    pointer-events: none;
  }
  .ost__record {
    position: absolute;
    inset: 8%;
    border-radius: 50%;
    background:
      radial-gradient(circle, transparent 31%, rgb(255 255 255 / 0.04) 31.4%, transparent 32%),
      radial-gradient(circle at 30% 25%, rgb(255 255 255 / 0.12), transparent 40%),
      #07080d;
    box-shadow:
      0 40px 80px -30px rgb(0 0 0 / 0.95),
      0 0 0 1px rgb(255 255 255 / 0.06),
      0 0 60px -10px color-mix(in srgb, var(--ost-accent, #a8d4ff) 35%, transparent);
    animation: spin 3.2s linear infinite;
    animation-play-state: paused;
  }
  :global(.ost__turntable.is-playing) .ost__record {
    animation-play-state: running;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  .ost__grooves {
    position: absolute;
    inset: 4%;
    border-radius: 50%;
    background: repeating-radial-gradient(circle, rgb(255 255 255 / 0.035) 0 1px, transparent 1px 4px);
    mask: radial-gradient(circle, transparent 34%, #000 35%);
  }
  .ost__label {
    position: absolute;
    inset: 31%;
    overflow: hidden;
    border-radius: 50%;
    box-shadow: 0 0 0 4px #07080d, 0 0 0 5px rgb(255 255 255 / 0.1);
  }
  .ost__label :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ost__label::after {
    content: "";
    position: absolute;
    inset: 46%;
    border-radius: 50%;
    background: var(--ink-0);
  }
  .ost__arm {
    position: absolute;
    top: -2%;
    right: 2%;
    width: 30%;
    height: 62%;
    transform-origin: 78% 8%;
    transform: rotate(-30deg);
    transition: transform 1s var(--ease-out);
    pointer-events: none;
  }
  :global(.ost__turntable.is-playing) .ost__arm {
    transform: rotate(-6deg);
  }
  .ost__arm::before {
    content: "";
    position: absolute;
    top: 0;
    right: 12%;
    width: 22%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, #2a3042 30%, #11141d 32%);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.12);
  }
  .ost__arm i {
    position: absolute;
    top: 7%;
    right: 22%;
    width: 4px;
    height: 88%;
    border-radius: 4px;
    background: linear-gradient(var(--pale-2), var(--pale-4));
    transform: rotate(8deg);
    transform-origin: top;
  }
  .ost__arm i::after {
    content: "";
    position: absolute;
    bottom: -6px;
    left: -6px;
    width: 16px;
    height: 22px;
    border-radius: 3px;
    background: var(--pale-3);
  }

  .ost__panel :global(.sh) {
    margin-bottom: 32px;
  }
  .ost__list {
    display: grid;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .ost__track {
    display: grid;
    grid-template-columns: 40px 1fr auto;
    align-items: center;
    gap: 16px;
    width: 100%;
    padding: 16px 8px;
    text-align: left;
    border-bottom: 1px solid var(--line);
    transition: background 0.3s;
  }
  .ost__track:hover {
    background: rgb(255 255 255 / 0.03);
  }
  .ost__track[aria-pressed="true"] {
    background: linear-gradient(90deg, color-mix(in srgb, var(--accent) 16%, transparent), transparent 80%);
  }
  .ost__no {
    font-family: var(--font-display-stack);
    font-size: 0.8rem;
    color: var(--pale-4);
  }
  .ost__track[aria-pressed="true"] .ost__no {
    color: var(--accent);
  }
  .ost__meta {
    display: grid;
    line-height: 1.4;
  }
  .ost__title {
    font-family: var(--font-display-stack);
    font-size: 1.08rem;
    letter-spacing: 0.04em;
    color: var(--pale);
  }
  .ost__album {
    font-size: 0.8rem;
    color: var(--pale-4);
  }
  .ost__dur {
    font-family: var(--font-display-stack);
    font-size: 0.8rem;
    color: var(--pale-3);
    font-variant-numeric: tabular-nums;
  }

  .ost__controls {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 24px;
  }
  .ost__btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: 50%;
    color: var(--pale-2);
    transition: color 0.3s, background 0.3s;
  }
  .ost__btn svg {
    width: 18px;
  }
  .ost__btn:hover {
    color: var(--pale);
    background: rgb(255 255 255 / 0.06);
  }
  .ost__btn--main {
    width: 54px;
    height: 54px;
    color: var(--ink-0);
    background: var(--pale);
    box-shadow: 0 0 30px -4px rgb(168 212 255 / 0.5);
  }
  .ost__btn--main:hover {
    color: var(--ink-0);
    background: #fff;
  }
  .ost__icon-pause,
  :global(.is-playing) .ost__icon-play {
    display: none;
  }
  :global(.is-playing) .ost__icon-pause {
    display: block;
  }
  .ost__progress {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  .ost__time {
    font-family: var(--font-display-stack);
    font-size: 0.74rem;
    color: var(--pale-4);
    font-variant-numeric: tabular-nums;
  }
  .ost__seek {
    --p: 0%;
    flex: 1;
    min-width: 0;
    height: 18px;
    margin: 0;
    background: transparent;
    appearance: none;
    cursor: pointer;
  }
  .ost__seek::-webkit-slider-runnable-track {
    height: 2px;
    background: linear-gradient(90deg, var(--pale) var(--p), var(--line-2) var(--p));
  }
  .ost__seek::-moz-range-track {
    height: 2px;
    background: linear-gradient(90deg, var(--pale) var(--p), var(--line-2) var(--p));
  }
  .ost__seek::-webkit-slider-thumb {
    width: 12px;
    height: 12px;
    margin-top: -5px;
    border-radius: 50%;
    background: var(--pale);
    appearance: none;
    box-shadow: 0 0 10px rgb(168 212 255 / 0.8);
  }
  .ost__seek::-moz-range-thumb {
    width: 12px;
    height: 12px;
    border: 0;
    border-radius: 50%;
    background: var(--pale);
  }
  .ost__credit {
    margin-top: 18px;
    font-size: 0.74rem;
    color: var(--pale-4);
  }

  @media (max-width: 900px) {
    .ost__grid {
      grid-template-columns: 1fr;
    }
    .ost__turntable {
      width: min(380px, 78vw);
    }
  }
</style>
